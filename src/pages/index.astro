---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PhoneDisplay from "@/components/PhoneDisplay.astro";
import MeanderWatermark from "@/components/MeanderWatermark.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import CoverageCard from "@/components/CoverageCard.astro";
import CarrierCarousel from "@/components/CarrierCarousel.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import ClosingCta from "@/components/ClosingCta.astro";
import { coverage } from "@/data/coverage";
import reviewData from "@/data/reviews.json";
import {
  mainPhone,
  hours,
  google,
  address,
  legalName,
  brandName,
  siteUrl,
  licensedStates,
  licensedStatesSentence,
  npn,
  kentuckyLicense,
} from "@/data/site";

// Entries the client has not filled in yet are skipped so the section never
// renders a blank card. See the instructions block in reviews.json.
const reviews = reviewData.reviews.filter((review) => review.text.trim().length > 0);

const organization = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "@id": `${siteUrl}/#organization`,
  name: brandName,
  legalName,
  alternateName: brandName,
  description:
    "Independent property and casualty insurance brokerage in Louisville, Kentucky, licensed in Kentucky, Indiana, and Ohio.",
  url: siteUrl,
  telephone: `+1${mainPhone.raw}`,
  email: "sam@spartanshieldins.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: `${address.street}, ${address.suite}`,
    addressLocality: address.city,
    addressRegion: address.state,
    postalCode: address.zip,
    addressCountry: address.country,
  },
  // Only emitted once real coordinates for the new address are in site.ts.
  ...(address.geo
    ? {
        geo: {
          "@type": "GeoCoordinates",
          latitude: address.geo.latitude,
          longitude: address.geo.longitude,
        },
      }
    : {}),
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: hours.days.map((day) => `https://schema.org/${day}`),
      opens: hours.opens,
      closes: hours.closes,
    },
  ],
  areaServed: licensedStates.map((state) => ({
    "@type": "State",
    name: state.name,
  })),
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: google.rating,
    reviewCount: google.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
  identifier: [
    { "@type": "PropertyValue", name: "NPN", value: npn },
    { "@type": "PropertyValue", name: "Kentucky license", value: kentuckyLicense },
  ],
  sameAs: [google.profileUrl],
  knowsAbout: ["Auto insurance", "Home insurance", "Renters insurance", "Commercial insurance"],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: siteUrl,
  name: brandName,
  publisher: { "@id": `${siteUrl}/#organization` },
};
---

<BaseLayout
  title="Independent Insurance Agency in Louisville, KY | Spartan Shield Insurance"
  rawTitle={true}
  description="Independent insurance brokers in Louisville, KY. We shop the market for auto, home, renters, and business coverage across Kentucky, Indiana, and Ohio."
  schema={[organization, website]}
>
  <!-- ===================================================================
       HERO — the phone number is the signature element (spec 4.4)
       =================================================================== -->
  <section
    class="relative isolate overflow-hidden bg-ink"
    aria-labelledby="hero-heading"
  >
    <MeanderWatermark
      class="pointer-events-none absolute -right-24 -top-16 z-0 h-[520px] w-[520px] rotate-[-12deg] text-gold lg:-right-16 lg:h-[680px] lg:w-[680px]"
      opacity={0.03}
    />

    <div class="container-site relative z-10">
      <div
        class="hero-seq flex min-h-[calc(100svh-var(--header-h))] max-w-3xl flex-col justify-center py-16 lg:py-24"
      >
        <Eyebrow>Independent insurance brokers · Louisville, Kentucky</Eyebrow>

        <h1 id="hero-heading" class="type-h1 mt-6 text-on-dark">
          One Call<br />Get the Right Coverage at the Right Price.
        </h1>

        <p class="type-body mt-6 max-w-xl text-on-dark-mu">
          We shop the market to find the right carrier for you, then customize the coverage for
          your specific needs.
        </p>

        <PhoneDisplay
          phone={mainPhone}
          scale="hero"
          tone="on-dark"
          rule={true}
          buttons={true}
          microline={hours.short}
          class="mt-12"
        />
      </div>
    </div>
  </section>

  <!-- ===================================================================
       TRUST STRIP
       =================================================================== -->
  <section class="border-y border-slate/40 bg-charcoal" aria-label="Agency credentials">
    <div class="container-site">
      <ul
        class="grid divide-y divide-slate/40 md:grid-cols-3 md:divide-x md:divide-y-0"
      >
        <li class="flex flex-col items-center gap-2 px-4 py-7 text-center md:py-8">
          <a
            href={google.reviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-2 no-underline transition-opacity duration-150 hover:opacity-80"
          >
            <span class="flex items-center gap-1" role="img" aria-label="5 out of 5 stars">
              {
                Array.from({ length: 5 }).map(() => (
                  <svg
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="text-gold"
                    aria-hidden="true"
                  >
                    <path d="M12 2.5l2.9 5.9 6.6.95-4.75 4.63 1.12 6.52L12 17.42 6.13 20.5l1.12-6.52L2.5 9.35l6.6-.95L12 2.5z" />
                  </svg>
                ))
              }
            </span>
            <span class="text-[0.9375rem] font-medium text-on-dark">
              {google.ratingDisplay} on Google · {google.reviewCount} reviews
            </span>
          </a>
        </li>

        <li class="flex items-center justify-center px-4 py-7 text-center md:py-8">
          <span class="text-[0.9375rem] font-medium text-on-dark">
            Licensed in {licensedStatesSentence}
          </span>
        </li>

        <li class="flex items-center justify-center px-4 py-7 text-center md:py-8">
          <span class="text-[0.9375rem] font-medium text-on-dark">
            Independent agency, founded 2025
          </span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ===================================================================
       COVERAGE
       =================================================================== -->
  <section class="section-y bg-parchment" aria-labelledby="coverage-heading">
    <div class="container-site">
      <Eyebrow tone="on-light">What we write</Eyebrow>
      <h2 id="coverage-heading" class="type-h2 mt-4 max-w-2xl text-on-light">
        Personal and commercial coverage, shopped every renewal.
      </h2>

      {/* Three tiles since the Business card was removed. Capped and centred
          so they do not stretch to fill a four-column measure. */}
      <div
        class="mx-auto mt-12 grid max-w-5xl gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3"
      >
        {coverage.map((item) => <CoverageCard item={item} />)}
      </div>
    </div>
  </section>

  <!-- ===================================================================
       CARRIERS — the one pure-white section
       =================================================================== -->
  {/* Shorter rhythm than a full section: this band is now just an
       eyebrow and the logo strip, so full section padding left it floating. */}
  <section class="section-y-sm bg-pure-white" aria-labelledby="carriers-heading">
    <div class="container-site">
      {/* The eyebrow is the only heading here now — it carries the section's
          accessible name so the landmark is still labelled. */}
      <Eyebrow tone="on-light" as="h2" id="carriers-heading">
        Some of our Carriers
      </Eyebrow>

      <div class="mt-8 lg:mt-10">
        <CarrierCarousel />
      </div>
    </div>
  </section>

  <!-- ===================================================================
       REVIEWS
       =================================================================== -->
  <section class="section-y bg-ink" aria-labelledby="reviews-heading">
    <div class="container-site">
      {/* The eyebrow is the section's only heading now, so it carries the
          accessible name. */}
      <Eyebrow as="h2" id="reviews-heading">What clients say</Eyebrow>

      {
        reviews.length > 0 ? (
          <>
            {/* Scroll-snap rail on mobile, three-column grid on desktop. */}
            <div class="snap-rail mt-10 lg:hidden">
              {reviews.map((review) => (
                <ReviewCard
                  display={review.display}
                  stars={review.stars}
                  text={review.text}
                  source={review.source}
                />
              ))}
            </div>

            <div class="mt-12 hidden items-stretch gap-5 lg:grid lg:grid-cols-3">
              {reviews.map((review) => (
                <ReviewCard
                  display={review.display}
                  stars={review.stars}
                  text={review.text}
                  source={review.source}
                />
              ))}
            </div>
          </>
        ) : (
          /* Renders only until Sam pastes the real review text. Never ships
             invented testimonials. */
          <div
            class="mt-12 rounded-[8px] border border-dashed border-slate p-8 text-center"
            data-placeholder="reviews"
          >
            <p class="type-body text-on-dark-mu">
              Review text is pending. It must be pasted verbatim from the Google Business
              Profile into <code class="text-gold">src/data/reviews.json</code> — reviews are
              the reviewers' words and are never written by the build.
            </p>
          </div>
        )
      }

      <p class="mt-10">
        <a
          href={google.reviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold text-gold no-underline transition-colors duration-150 hover:text-gold-lo"
        >
          Read all {google.reviewCount} reviews on Google
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17L17 7M8 7h9v9"></path>
          </svg>
        </a>
      </p>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
