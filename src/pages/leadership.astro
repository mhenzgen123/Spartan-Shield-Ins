---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LeaderCard from "@/components/LeaderCard.astro";
import ClosingCta from "@/components/ClosingCta.astro";
import { leaders, licensingLine } from "@/data/site";
---

<BaseLayout
  title="Leadership"
  description="Meet Sam Genuis and Nick Henzgen, co-founders of Spartan Shield Insurance in Louisville, Kentucky. Both owners carry a direct line, and both answer it."
>
  <section class="section-y bg-ink" aria-labelledby="leadership-heading">
    <div class="container-site">
      {/*
        The visible heading and intro were removed at the client's request so
        the page opens on the two headshots. An accessible page title is still
        required — every page needs exactly one h1, and a screen reader user
        landing here needs to know what the page is — so the h1 remains as
        visually hidden text.
      */}
      <h1 id="leadership-heading" class="sr-only">Leadership</h1>

      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
        {leaders.map((leader) => <LeaderCard leader={leader} />)}
      </div>

      <p class="type-small mt-12 max-w-3xl text-on-dark-mu">
        {licensingLine}
      </p>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
