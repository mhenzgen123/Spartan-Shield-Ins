---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ApplicationForm from "@/components/ApplicationForm";
import roleData from "@/data/roles.json";
import { leaders, hours } from "@/data/site";

const roles = roleData.roles.map((role) => ({ slug: role.slug, title: role.title }));
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<BaseLayout
  title="Apply"
  description="Apply to Spartan Shield Insurance in Louisville, KY. Send your resume for the Sales Executive or Client Relations Specialist role. Both positions are hybrid."
>
  <section class="section-y bg-parchment" aria-labelledby="apply-heading">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <Eyebrow tone="on-light">Application</Eyebrow>
          <h1 id="apply-heading" class="type-h1 mt-6 text-on-light">Apply to join us.</h1>

          <p class="type-body mt-6 text-on-light-mu">
            One page, no account to create. Both owners see every application, and one of us
            replies — including when the answer is no.
          </p>

          <p class="type-body mt-4 text-on-light-mu">
            We answer weekdays, {hours.short.replace("Monday to Friday, ", "")}.
          </p>

          <div class="mt-10 border-l-2 border-oxblood/30 pl-5">
            <p class="type-small font-semibold text-on-light">Rather talk first?</p>
            <p class="type-small mt-1 text-on-light-mu">
              Call or text either owner directly. No screening call required to get a real
              conversation.
            </p>
            <ul class="mt-3 space-y-1">
              {
                leaders.map((leader) => (
                  <li>
                    <a
                      href={leader.phone.tel}
                      class="text-[0.9375rem] font-semibold tabular-nums text-oxblood no-underline transition-colors duration-150 hover:text-oxblood-lo"
                    >
                      {leader.name} · {leader.phone.display}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="card-light p-6 lg:p-8">
            <ApplicationForm roles={roles} siteKey={siteKey} client:load />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
