---
/**
 * Post-submission confirmation.
 *
 * Excluded from the sitemap and marked noindex — it is a destination for a
 * redirect, not a page anyone should land on from search. The `?type=` query
 * param tailors the copy; a tiny inline script handles it because the page is
 * statically rendered and the param is only known in the browser.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import MeanderRule from "@/components/MeanderRule.astro";
import { mainPhone, leaders, hours, url } from "@/data/site";
---

<BaseLayout
  title="Thank you"
  description="Thanks for getting in touch with Spartan Shield Insurance, independent insurance brokers in Louisville, Kentucky. We answer weekdays, 8am to 6pm Eastern."
  noindex={true}
>
  <section class="section-y bg-ink">
    <div class="container-site">
      <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
        <Eyebrow>Received</Eyebrow>

        <h1 class="type-h1 mt-6 text-on-dark" data-thanks-heading>Thanks — we have it.</h1>

        <p class="type-body mt-6 text-on-dark-mu" data-thanks-body>
          One of the owners will get back to you. We answer weekdays, {hours.short.replace(
            "Monday to Friday, ",
            "",
          )}.
        </p>

        <MeanderRule variant="center" width={140} class="mt-10 w-full max-w-md text-gold/70" />

        <p class="type-body mt-10 text-on-dark-mu">If it is urgent, call us instead.</p>

        <a
          href={mainPhone.tel}
          class="mt-3 text-[clamp(2rem,6vw,3rem)] font-bold leading-none tabular-nums tracking-[-0.03em] text-on-dark no-underline transition-colors duration-150 hover:text-gold-lo"
        >
          {mainPhone.display}
        </a>

        <ul class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3">
          {
            leaders.map((leader) => (
              <li>
                <a
                  href={leader.phone.tel}
                  class="text-[0.9375rem] font-medium tabular-nums text-on-dark-mu no-underline transition-colors duration-150 hover:text-gold-lo"
                >
                  {leader.name} · {leader.phone.display}
                </a>
              </li>
            ))
          }
        </ul>

        <a href={url("/")} class="btn btn-outline mt-12">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Tailor the confirmation copy to what was submitted.
  const type = new URLSearchParams(window.location.search).get("type");
  const heading = document.querySelector<HTMLElement>("[data-thanks-heading]");
  const body = document.querySelector<HTMLElement>("[data-thanks-body]");

  if (type === "application" && heading && body) {
    heading.textContent = "Application received.";
    body.textContent =
      "Both owners see every application, and one of us will reply — including if the answer is no. We answer weekdays, 8am to 6pm ET.";
  }
</script>
