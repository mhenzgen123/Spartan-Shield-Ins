---
/**
 * Fixed bottom bar, mobile only — spec 5.1.
 *
 * Two half-width buttons, Call and Text, on every page except /careers/admin.
 * The body gets bottom padding from BaseLayout so the bar never covers the
 * last line of the footer.
 */
import { mainPhone } from "@/data/site";
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-slate/50 bg-ink/95 backdrop-blur-md lg:hidden"
  style="padding-bottom:env(safe-area-inset-bottom)"
>
  <a
    href={mainPhone.tel}
    class="flex min-h-[56px] items-center justify-center gap-2 bg-oxblood text-[0.9375rem] font-semibold text-parchment no-underline transition-colors duration-150 hover:bg-oxblood-lo"
    aria-label={`Call Spartan Shield Insurance at ${mainPhone.display}`}
  >
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
      ></path>
    </svg>
    Call
  </a>

  <a
    href={mainPhone.sms}
    class="flex min-h-[56px] items-center justify-center gap-2 border-l border-slate/50 text-[0.9375rem] font-semibold text-gold no-underline transition-colors duration-150 hover:text-gold-lo"
    aria-label={`Text Spartan Shield Insurance at ${mainPhone.display}`}
  >
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
      ></path>
    </svg>
    Text
  </a>
</div>
