---
/**
 * Leadership card — spec 5.3.
 *
 * Square headshot on cream, gold hairline meander rule beneath, name in
 * Marcellus caps, title in Archivo 500, then a contact block where both the
 * phone and the email are real links with visible focus states.
 *
 * Headshots are 750x900 (a 5:6 portrait), so the frame is 5:6 rather than
 * square — a 1:1 frame would crop roughly a sixth off the top and bottom of
 * each photo.
 *
 * Until the image files exist this renders a monogram placeholder. Drop these
 * files into public/team/ and the photo appears automatically on the next
 * build, no code change needed:
 *
 *   sam-genuis-750.jpg    sam-genuis-750.webp
 *   nick-henzgen-750.jpg  nick-henzgen-750.webp
 *
 * The .webp is optional — the .jpg alone is enough to switch the card over.
 */
import fs from "node:fs";
import path from "node:path";
import { url, type Leader } from "@/data/site";
import MeanderRule from "./MeanderRule.astro";

interface Props {
  leader: Leader;
}

const { leader } = Astro.props;

const teamDir = path.resolve(process.cwd(), "public", "team");
const base = `${leader.slug}`;
const hasPhoto = fs.existsSync(path.join(teamDir, `${base}-750.jpg`));
const hasWebp = fs.existsSync(path.join(teamDir, `${base}-750.webp`));

const initials = leader.name
  .split(" ")
  .map((part) => part[0])
  .join("");
---

<article class="card-dark overflow-hidden">
  <div class="aspect-[5/6] w-full bg-cream">
    {
      hasPhoto ? (
        <picture>
          {hasWebp && (
            <source type="image/webp" srcset={url(`/team/${base}-750.webp`)} />
          )}
          <img
            src={url(`/team/${base}-750.jpg`)}
            alt={leader.headshotAlt}
            width="750"
            height="900"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-top"
          />
        </picture>
      ) : (
        <div
          class="flex h-full w-full items-center justify-center"
          data-placeholder="headshot"
          role="img"
          aria-label={`Photograph of ${leader.name} — pending`}
        >
          {/* The wrapper already carries role="img" and a label, so the
              monogram itself is decorative — hiding it keeps a screen reader
              from announcing loose letters, and keeps the contrast checker
              off a purely ornamental glyph. */}
          <span
            aria-hidden="true"
            class="font-display text-[clamp(3rem,10vw,5rem)] tracking-[0.08em] text-oxblood/60"
          >
            {initials}
          </span>
        </div>
      )
    }
  </div>

  <div class="p-6 lg:p-8">
    <MeanderRule variant="center" width={110} class="text-gold/70" />

    <h2 class="type-founder mt-6 text-on-dark">{leader.displayName}</h2>
    <p class="mt-1 text-[0.9375rem] font-medium text-on-dark-mu">{leader.title}</p>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="type-eyebrow text-[0.6875rem] text-gold">Direct</dt>
        <dd class="mt-1">
          <a
            href={leader.phone.tel}
            class="text-[1.0625rem] font-semibold tabular-nums text-on-dark no-underline transition-colors duration-150 hover:text-gold-lo"
          >
            {leader.phone.display}
          </a>
        </dd>
      </div>

      <div class="min-w-0">
        <dt class="type-eyebrow text-[0.6875rem] text-gold">Email</dt>
        <dd class="mt-1">
          <a
            href={`mailto:${leader.email}`}
            class="block break-all text-[0.9375rem] text-on-dark no-underline transition-colors duration-150 hover:text-gold-lo"
          >
            {leader.email}
          </a>
        </dd>
      </div>
    </dl>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href={leader.phone.tel} class="btn btn-primary sm:flex-1">Call {leader.name.split(" ")[0]}</a>
      <a href={leader.phone.sms} class="btn btn-outline sm:flex-1">Send a text</a>
    </div>
  </div>
</article>
