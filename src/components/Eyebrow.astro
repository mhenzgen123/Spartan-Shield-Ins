---
/**
 * Section eyebrow. Marcellus caps at 0.18em tracking — spec 4.3.
 * Gold on dark surfaces, oxblood on light ones (gold text fails AA on
 * parchment, spec 4.2).
 *
 * `as` can be a heading when the eyebrow is the section's only heading, so the
 * landmark still gets an accessible name. Any extra attributes (id, aria-*)
 * pass straight through.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"p"> & {
  tone?: "on-dark" | "on-light" | "on-oxblood";
  as?: "p" | "h2" | "h3" | "span";
};

const { tone = "on-dark", as: Tag = "p", class: className, ...rest } = Astro.props;

const color =
  tone === "on-light" ? "text-oxblood" : tone === "on-oxblood" ? "text-gold-lo" : "text-gold";
---

<Tag class:list={["type-eyebrow", color, className]} {...rest}>
  <slot />
</Tag>
