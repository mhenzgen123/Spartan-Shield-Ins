---
/**
 * THE SIGNATURE ELEMENT — spec 4.4.
 *
 * Every insurance site buries the phone number in a small button and pushes a
 * quote form. This agency's strategy is that the owners are the point of
 * contact, so the number itself is set as display typography, not as a widget.
 *
 * This is the one place to spend boldness. Everything else stays disciplined.
 */
import type { Phone } from "@/data/site";
import MeanderRule from "./MeanderRule.astro";

interface Props {
  phone: Phone;
  /** "hero" is the full display treatment; "large" is the closing CTA / contact page. */
  scale?: "hero" | "large";
  /** Colour context. Controls the outline button variant and rule opacity. */
  tone?: "on-dark" | "on-oxblood" | "on-light";
  /** Draw the hairline meander rule above the number. */
  rule?: boolean;
  /** Render the Call / Text button pair beneath. */
  buttons?: boolean;
  /** Small line under the buttons, e.g. opening hours. */
  microline?: string;
  /** Accessible label for the number link. */
  label?: string;
  align?: "start" | "center";
  class?: string;
}

const {
  phone,
  scale = "hero",
  tone = "on-dark",
  rule = true,
  buttons = true,
  microline,
  label,
  align = "start",
  class: className = "",
} = Astro.props;

const centered = align === "center";

const numberClass = scale === "hero" ? "type-hero-phone" : "text-[clamp(2rem,6vw,3.5rem)] font-bold tracking-[-0.03em] leading-none tabular-nums";

// Gold fails AA as text on light backgrounds (spec 4.2), so the rule and the
// outline button switch to oxblood there.
const ruleColor = tone === "on-light" ? "text-oxblood/45" : "text-gold/70";
const numberColor =
  tone === "on-light" ? "text-on-light hover:text-oxblood" : "text-on-dark hover:text-gold-lo";
const outlineBtn = tone === "on-light" ? "btn-outline-dark" : "btn-outline";
const primaryBtn = tone === "on-oxblood" ? "btn-primary-inverse" : "btn-primary";
const microColor = tone === "on-light" ? "text-on-light-mu" : "text-on-dark-mu";
---

<div class:list={["flex flex-col", centered ? "items-center text-center" : "items-start", className]}>
  {
    rule && (
      <MeanderRule
        variant="center"
        width={140}
        class:list={["mb-6 w-full max-w-md", ruleColor]}
      />
    )
  }

  <a
    href={phone.tel}
    class:list={[
      numberClass,
      numberColor,
      "block transition-colors duration-150 no-underline",
    ]}
    aria-label={label ?? `Call Spartan Shield Insurance at ${phone.display}`}
  >
    {phone.display}
  </a>

  {
    buttons && (
      <div
        class:list={[
          "mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row",
          centered && "sm:justify-center",
        ]}
      >
        <a href={phone.tel} class:list={["btn", primaryBtn]} data-cta="call">
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Call now
        </a>

        <a href={phone.sms} class:list={["btn", outlineBtn]} data-cta="text">
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          Send a text
        </a>
      </div>
    )
  }

  {
    microline && (
      <p class:list={["type-small mt-5", microColor]}>{microline}</p>
    )
  }
</div>
