---
/**
 * Greek meander (key) hairline divider.
 *
 * Spec 4.1: the classical vocabulary is treated as STRUCTURE, not decoration.
 * This renders as a rule between or above blocks. It never sits behind text.
 *
 * The tile is a single continuous stroke that connects seamlessly to the next
 * tile, so the pattern reads as one drawn line rather than repeated stamps.
 */

interface Props {
  /** "center" draws flanking hairlines out to the container edge. */
  variant?: "center" | "full" | "bare";
  /** Motif width when variant is "center". */
  width?: number;
  class?: string;
  /** Applies the draw-in animation used by the hero sequence. */
  animate?: boolean;
  /** Accessible label; omitted entirely by default since this is decorative. */
  label?: string;
}

const {
  variant = "center",
  width = 168,
  class: className = "",
  animate = false,
  label,
} = Astro.props;

// Unique id per instance — multiple meanders on one page must not collide.
const uid = `meander-${Math.random().toString(36).slice(2, 9)}`;

const TILE_W = 24;
const TILE_H = 16;
// One continuous spiral that exits at the same y it entered, so tiles join.
const TILE_PATH = "M0 15 L0 1 L20 1 L20 11 L8 11 L8 5 L16 5 L16 15 L24 15";
---

<div
  class:list={[
    "flex items-center gap-4",
    variant === "center" && "w-full",
    animate && "meander-draw",
    className,
  ]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "separator" : undefined}
  aria-label={label}
>
  {
    variant === "center" && (
      <span class="h-px flex-1 bg-current opacity-30" />
    )
  }

  <svg
    width={variant === "full" ? "100%" : width}
    height={TILE_H}
    viewBox={variant === "full" ? undefined : `0 0 ${width} ${TILE_H}`}
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    focusable="false"
    class:list={[variant === "full" && "w-full", "shrink-0 overflow-hidden"]}
    style={`height:${TILE_H}px`}
  >
    <defs>
      <pattern
        id={uid}
        width={TILE_W}
        height={TILE_H}
        patternUnits="userSpaceOnUse"
      >
        <path
          d={TILE_PATH}
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="square"
          fill="none"
          vector-effect="non-scaling-stroke"
        />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${uid})`} />
  </svg>

  {
    variant === "center" && (
      <span class="h-px flex-1 bg-current opacity-30" />
    )
  }
</div>
