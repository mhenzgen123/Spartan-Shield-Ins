---
/**
 * Coverage card — spec 5.2.
 * Oxblood line icon, H3, two sentences, and a `tel:` link. No quote-form links.
 */
import type { Coverage } from "@/data/coverage";
import { mainPhone } from "@/data/site";

interface Props {
  item: Coverage;
}

const { item } = Astro.props;

const paths: Record<Coverage["icon"], string[]> = {
  auto: [
    "M5 17h14M6.5 17a1.75 1.75 0 1 1-3.5 0 1.75 1.75 0 0 1 3.5 0ZM21 17a1.75 1.75 0 1 1-3.5 0 1.75 1.75 0 0 1 3.5 0Z",
    "M3.25 17v-4.2a2 2 0 0 1 .2-.88l2.1-4.3A2 2 0 0 1 7.35 6.5h9.3a2 2 0 0 1 1.8 1.12l2.1 4.3a2 2 0 0 1 .2.88V17",
    "M4 12.5h16",
  ],
  home: ["M3.5 10.5 12 3.5l8.5 7", "M5.5 9v11.5h13V9", "M10 20.5v-6h4v6"],
  renters: [
    "M3.5 10.5 12 3.5l8.5 7",
    "M5.5 9v11.5h13V9",
    "M12 12.25a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm0 4v2.25",
  ],
};
---

<article class="card-light flex flex-col p-6 lg:p-7">
  <svg
    width="30"
    height="30"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-oxblood"
    aria-hidden="true"
  >
    {paths[item.icon].map((d) => <path d={d} />)}
  </svg>

  <h3 class="type-h3 mt-5 text-on-light">{item.title}</h3>

  <p class="type-body mt-3 grow text-on-light-mu">{item.body}</p>

  <a
    href={mainPhone.tel}
    class="-mx-2 mt-5 inline-flex min-h-[44px] items-center gap-1.5 self-start px-2 text-[0.9375rem] font-semibold text-oxblood no-underline transition-colors duration-150 hover:text-oxblood-lo"
  >
    Call about {item.callLabel}
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </a>
</article>
