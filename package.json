{
  "name": "spartan-shield-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 execute spartan-shield --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "echo 'Run the SQL in migrations/0001_init.sql from the Cloudflare dashboard: D1 > spartan-shield > Console. See DEPLOYMENT.md.'",
    "check:functions": "tsc -p functions/tsconfig.json",
    "check:all": "npm run check && npm run check:functions",
    "assets": "node scripts/generate-assets.mjs",
    "dev:functions": "wrangler pages dev"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260807.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  }
}
