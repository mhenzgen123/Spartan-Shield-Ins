# Copy to .env for local development. NEVER commit .env — it is gitignored.
#
# In production, set every value below in the Cloudflare dashboard:
#   Workers & Pages → spartan-shield-web → Settings → Variables and Secrets
# Mark everything labelled SECRET as "Encrypt" so it cannot be read back.
#
# Nothing in this file has a real value. It is a checklist, not a config.

# --- Email notification (Resend) ----------------------------------------
# SECRET. Create at https://resend.com → API Keys
RESEND_API_KEY=

# Where new leads and applications are sent.
NOTIFY_EMAILS=sam@spartanshieldins.com,nick@spartanshieldins.com

# Must be on a VERIFIED SENDING SUBDOMAIN (send.spartanshieldins.com), never
# the root domain — verifying the root would mean touching the Microsoft 365
# mail records and risking business email.
NOTIFY_FROM=notifications@send.spartanshieldins.com

# Master switch. "false" means submissions land in D1 only and the owners have
# to check /careers/admin. Leads will sit unseen — turn this on before launch.
ENABLE_EMAIL_NOTIFY=false

# --- Spam protection (Cloudflare Turnstile) ------------------------------
# Create at Cloudflare dashboard → Turnstile → Add site.
# The SITE key is public and is baked into the client bundle at build time, so
# it must be prefixed PUBLIC_ for Astro to expose it.
PUBLIC_TURNSTILE_SITE_KEY=

# SECRET. Server-side verification. While this is unset, form verification is
# SKIPPED — set it before launch.
TURNSTILE_SECRET_KEY=

# --- Admin auth (Cloudflare Access) --------------------------------------
# Zero Trust → Settings → Custom Pages shows your team domain.
# Example: spartanshield.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=

# The Application Audience (AUD) tag from the Access application that protects
# /careers/admin* and /api/admin*. Zero Trust → Access → Applications → Overview.
# If this is unset, every admin API call returns 500 rather than falling open.
CF_ACCESS_AUD=
